<?xml version="1.0" encoding="utf-8"?>
<!-- one player, or one team with its members, of the players screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- long press to move the row: the players are given in the order they sit -->
        <TextView
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:id="@+id/PlayerNumber"
            android:gravity="center_vertical"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/PlayerName"
            android:background="@null"
            android:hint="Név"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="20sp" />

        <!-- no arrow, the chip itself shows it can be tapped, so the name has more room -->
        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/PlayerLevel"
            android:background="@null" />

        <!-- the time to answer, e.g. more for children -->
        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/PlayerTime"
            android:layout_marginStart="6dp"
            android:background="@null" />

        <!-- removes the player or the team, the rows below move up -->
        <TextView
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:id="@+id/PlayerRemove"
            android:contentDescription="Törlés"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/textSecondary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- only in team games: the members, every one with their own level and time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/MemberList"
        android:layout_marginStart="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ButtonNewMember"
        android:layout_marginStart="28dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="+ Új tag"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
