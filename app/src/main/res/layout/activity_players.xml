<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    tools:context=".PlayersActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            style="@style/ButtonSmall"
            android:id="@+id/ButtonBackPlayers"
            android:text="‹ Vissza" />

        <TextView
            style="@style/ScreenTitle"
            android:id="@+id/PlayersTitle"
            android:layout_marginStart="16dp"
            android:text="Játékosok" />
    </LinearLayout>

    <!-- every player for themselves, or teams whose members answer in turns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            style="@style/ButtonSecondary"
            android:id="@+id/ButtonModeSingle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="👤 Egyéni"
            android:textSize="18sp" />

        <Button
            style="@style/ButtonSecondary"
            android:id="@+id/ButtonModeTeams"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="👥 Csapat"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/PlayersHint"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="Add meg a neveket, és válassz mindenkinek szintet és időt!"
        android:textColor="@color/textSecondary"
        android:textSize="16sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- the rows of item_player, added in PlayersActivity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/PlayerList"
                android:orientation="vertical" />

            <Button
                style="@style/ButtonSecondary"
                android:id="@+id/ButtonNewPlayer"
                android:text="+ Új játékos" />
        </LinearLayout>
    </ScrollView>

    <Button
        style="@style/ButtonPrimary"
        android:id="@+id/ButtonNextPlayers"
        android:layout_marginTop="12dp"
        android:text="Tovább" />

</LinearLayout>
