<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    tools:context=".StatisticsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            style="@style/ButtonSmall"
            android:id="@+id/ButtonBackStatistics"
            android:text="‹ Vissza" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginStart="16dp"
            android:text="Statisztika" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/StatTile"
                    android:id="@+id/StatGames"
                    android:layout_marginEnd="8dp" />

                <TextView
                    style="@style/StatTile"
                    android:id="@+id/StatQuestions"
                    android:layout_marginEnd="8dp" />

                <TextView
                    style="@style/StatTile"
                    android:id="@+id/StatSuccess" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="Játékosok" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/PlayerStatistics"
                android:orientation="vertical" />

            <TextView
                style="@style/SectionTitle"
                android:text="Legnehezebb kérdések" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/HardestQuestions"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        style="@style/ButtonSecondary"
        android:id="@+id/ButtonDeleteStatistics"
        android:layout_marginTop="12dp"
        android:text="Statisztika törlése" />

</LinearLayout>
