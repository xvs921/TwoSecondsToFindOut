<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    tools:context=".RoundActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            style="@style/ButtonSmall"
            android:id="@+id/ButtonBackRound"
            android:text="‹ Vissza" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginStart="16dp"
            android:text="Körök" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/FirstPlayer"
            android:text="Az első játékos: "
            android:textColor="@color/textSecondary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/RoundText"
            android:layout_marginTop="24dp"
            android:text="Hány kör legyen?"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/ButtonSecondary"
                android:id="@+id/ButtonRoundMinus"
                android:layout_width="64dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="−"
                android:textSize="28sp" />

            <EditText
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:id="@+id/RoundNumber"
                android:background="@null"
                android:gravity="center"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/colorPrimary"
                android:textSize="48sp"
                android:textStyle="bold" />

            <Button
                style="@style/ButtonSecondary"
                android:id="@+id/ButtonRoundPlus"
                android:layout_width="64dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="+"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        style="@style/ButtonPrimary"
        android:id="@+id/ButtonNextRound"
        android:text="Indulhat a játék" />

</LinearLayout>
