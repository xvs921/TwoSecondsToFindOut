<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    tools:context=".RoundActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            style="@style/ButtonSmall"
            android:id="@+id/ButtonBackRound"
            android:text="‹ Vissza" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginStart="16dp"
            android:text="Körök" />
    </LinearLayout>

    <!-- the settings scroll on small screens, otherwise they are centered -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/FirstPlayer"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="18sp" />

<!-- one player answers in turn, or anybody: only flash questions, whoever answers first -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Ki válaszolhat?"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonAnswerOne"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🙋 Egy ember"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonAnswerAnybody"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="⚡ Bárki"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/AnswerHint"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

                <!-- a number of rounds, or until somebody has the target points -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Meddig tart a játék?"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonGoalRounds"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🔁 Körökig"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonGoalPoints"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🎯 Pontig"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/RoundText"
                    android:layout_marginTop="24dp"
                    android:text="Hány kör legyen?"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonRoundMinus"
                        android:layout_width="64dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="−"
                        android:textSize="28sp" />

                    <EditText
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/RoundNumber"
                        android:background="@null"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="@color/colorPrimary"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonRoundPlus"
                        android:layout_width="64dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="+"
                        android:textSize="28sp" />
                </LinearLayout>

                <!-- e.g. "Mindenki 3 kérdést kap, összesen 9." -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/RoundTotal"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Ki kérdez?"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonAskerMaster"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🧑 Játékmester"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonAskerPlayers"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="👥 Egymást"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/AskerHint"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Ki olvassa fel a kérdéseket?"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonReaderMaster"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🧑 Kérdező"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonReaderPhone"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="📱 Telefon"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Jelzés, ha letelt az idő"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- both can be on, or neither -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonSignalBeep"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="🔊 Hang"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonSignalVibrate"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="📳 Rezgés"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/StreakTitle"
                    android:layout_marginTop="32dp"
                    android:text="Sorozat-bónusz"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- on / off -->
                <Button
                    style="@style/ButtonSecondary"
                    android:id="@+id/ButtonStreakBonus"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🔥 3 találat egymás után: +1 pont"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/PassTitle"
                    android:layout_marginTop="32dp"
                    android:text="Passz"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- how many questions everybody can pass in a game -->
                <LinearLayout
                    android:id="@+id/PassRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonPass0"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Nincs"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonPass1"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="🃏 1"
                        android:textSize="18sp" />

                    <Button
                        style="@style/ButtonSecondary"
                        android:id="@+id/ButtonPass2"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🃏 2"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/PassHint"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Fejenként ennyi kérdést lehet továbbadni egy játékban, pontvesztés nélkül."
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        style="@style/ButtonPrimary"
        android:id="@+id/ButtonNextRound"
        android:text="Indulhat a játék" />

</LinearLayout>
