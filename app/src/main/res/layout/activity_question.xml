<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    android:gravity="center_horizontal"
    android:keepScreenOn="true"
    android:paddingBottom="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    tools:context=".QuestionActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/CurrentPlayer"
        android:background="@drawable/bg_chip"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="Játékos"
        android:textColor="@color/chipText"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/QuestionCard"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Question"
            android:gravity="center"
            android:text="Kérdés"
            android:textColor="@color/textPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Answer"
            android:gravity="center"
            android:text="Válasz"
            android:textColor="@color/answerText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- marks the question as wrong, it can be fixed later in the question editor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/FlagQuestion"
            android:layout_marginTop="12dp"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⚑ Hibás kérdés?"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- timer and Start, replaced by the standings at the end of a round -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/TimerArea"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:id="@+id/Timer"
            android:background="@drawable/bg_timer"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="0,000"
            android:textColor="@color/textPrimary"
            android:textSize="42sp"
            android:textStyle="bold" />

        <Button
            style="@style/ButtonPrimary"
            android:id="@+id/ButtonStartStop"
            android:layout_width="200dp"
            android:layout_marginTop="20dp"
            android:text="Start" />

        <!-- in place of Start while the question is read or the timer runs -->
        <Button
            style="@style/ButtonSecondary"
            android:id="@+id/ButtonRepeat"
            android:layout_width="200dp"
            android:layout_marginTop="20dp"
            android:text="↻ Újra"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/RoundArea"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/RoundTitle"
            android:gravity="center"
            android:textColor="@color/textPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/RoundStandings"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/textPrimary"
                android:textSize="20sp" />
        </ScrollView>

        <Button
            style="@style/ButtonPrimary"
            android:id="@+id/ButtonNextRound"
            android:layout_width="200dp"
            android:layout_marginTop="12dp"
            android:text="Tovább" />
    </LinearLayout>

    <!-- hidden while the standings are shown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/AnswerButtons"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                style="@style/ButtonSmall"
                android:id="@+id/ButtonUndo"
                android:text="↶ Visszavonás" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                style="@style/ButtonSmall"
                android:id="@+id/ButtonSkip"
                android:text="Másik kérdés ›" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:orientation="horizontal">

            <Button
                style="@style/ButtonDanger"
                android:id="@+id/ButtonNotOk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Késő" />

            <Button
                style="@style/ButtonSuccess"
                android:id="@+id/ButtonOk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Siker" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
