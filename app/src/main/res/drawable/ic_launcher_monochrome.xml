    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:translateX="21"
        android:translateY="20.3">

        <!-- crown, side button and the case as a ring -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M42,6h16v8h-16zM47,14h6v6h-6zM79.5,22l4.5,4.5l-4.5,4.5l-4.5,-4.5z" />
        <path
