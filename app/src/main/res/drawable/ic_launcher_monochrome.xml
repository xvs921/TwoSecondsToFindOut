            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M50,29v5M50,80v5M78,57h-5M22,57h5" />

        <!-- lightning bolt -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,34L38,61h11l-4,21l17,-29h-11z" />
    </group>
